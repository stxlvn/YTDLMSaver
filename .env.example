# --- обязательное ---
BOT_TOKEN=токен_от_BotFather
ADMIN_IDS=123456789

# --- локальный Telegram Bot API (файлы до 2000 MB) ---
# Убери эти строки для облачного Bot API с лимитом ~50 MB.
BOT_API_BASE_URL=http://127.0.0.1:8082
BOT_API_IS_LOCAL=true
MAX_FILE_SIZE=2097152000
SEND_AS_DOC_LIMIT=2097152000
# Нужны для docker compose up -d telegram-bot-api (my.telegram.org/apps):
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- тюнинг загрузчика ---
MAX_CONCURRENT_DOWNLOADS=1
DOWNLOAD_RATE_LIMIT_BYTES=4194304
DOWNLOAD_STALL_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO

# --- cookies (см. README, раздел «Cookies и обход блокировок») ---
# COOKIES_FILE=cookies.txt            # Instagram; по умолчанию рядом с main.py
# YT_COOKIES_FILE=yt_cookies.txt      # опционально: возрастные видео YouTube (18+)
# COOKIE_PROFILE_DIR=~/.cache/ytdlmsaver-cookie-profile   # профиль Playwright для keep-alive

# --- обход региональных блокировок (опционально) ---
# GEO_BYPASS_COUNTRY=DE
# PROXY_URL=socks5://user:pass@host:1080
